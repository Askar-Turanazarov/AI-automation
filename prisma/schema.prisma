generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // пулер Neon для приложения, прямое соединение — для prisma db push
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// Тексты: базовое поле — русский, *Uz — узбекский (латиница), *En — английский. Пустой перевод = показывается русский.
model Master {
  id          String          @id @default(cuid())
  name        String
  nameLatin   String          @default("")
  specialty   String
  specialtyUz String          @default("")
  specialtyEn String          @default("")
  bio         String          @default("")
  bioUz       String          @default("")
  bioEn       String          @default("")
  photoUrl    String          @default("")
  color       String          @default("#FF5A1F")
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  services    MasterService[]
  schedules   WorkSchedule[]
  timeOffs    TimeOff[]
  bookings    Booking[]
}

model Service {
  id            String          @id @default(cuid())
  name          String
  nameUz        String          @default("")
  nameEn        String          @default("")
  category      String
  categoryUz    String          @default("")
  categoryEn    String          @default("")
  description   String          @default("")
  descriptionUz String          @default("")
  descriptionEn String          @default("")
  durationMin   Int
  price         Int // сум (UZS)
  active        Boolean         @default(true)
  masters       MasterService[]
  bookings      Booking[]
}

model MasterService {
  masterId  String
  serviceId String
  master    Master  @relation(fields: [masterId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([masterId, serviceId])
}

/// weekday: 1 = Пн … 7 = Вс; время — минуты от полуночи (локальное время ателье)
model WorkSchedule {
  id       String @id @default(cuid())
  masterId String
  weekday  Int
  startMin Int
  endMin   Int
  master   Master @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([masterId, weekday])
}

model TimeOff {
  id       String @id @default(cuid())
  masterId String
  date     String // YYYY-MM-DD
  reason   String @default("")
  master   Master @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([masterId, date])
}

model Booking {
  id         String   @id @default(cuid())
  masterId   String
  serviceId  String
  date       String // YYYY-MM-DD
  startMin   Int
  endMin     Int
  clientName String
  phone      String
  car        String   @default("")
  comment    String   @default("")
  status     String   @default("confirmed") // pending | confirmed | done | cancelled
  source     String   @default("web") // web | bot | ai
  tgUserId    String?
  /// напоминание накануне отправлено / клиент нажал «Приду»
  remindedAt  DateTime?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  master      Master    @relation(fields: [masterId], references: [id], onDelete: Cascade)
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  review      Review?
  updates     WorkUpdate[]

  @@index([masterId, date])
  @@index([date])
  @@index([tgUserId])
}

/// Этап работ: текст и необязательное фото (файл хранится в Telegram, у нас — file_id)
model WorkUpdate {
  id          String   @id @default(cuid())
  bookingId   String
  text        String
  photoFileId String?
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

/// Оценка клиента после визита (из бота); на сайте — только опубликованные с текстом
model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  rating    Int
  text      String   @default("")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([published])
}

/// Язык клиента в Telegram (ru | uz | en)
model TelegramUser {
  id        String   @id
  locale    String
  updatedAt DateTime @updatedAt
}

/// Состояние диалога бота (черновик записи, история ИИ) — JSON; нужен для webhook на serverless
model BotSession {
  chatId    String   @id
  data      String
  updatedAt DateTime @updatedAt
}

/// Лимит запросов (фиксированное окно) — общий для всех serverless-инстансов
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model AiLog {
  id        String   @id @default(cuid())
  provider  String
  model     String
  ok        Boolean
  error     String   @default("")
  latencyMs Int
  channel   String   @default("web") // web | bot | admin
  createdAt DateTime @default(now())

  @@index([createdAt])
}
