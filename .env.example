DATABASE_URL="file:./dev.db"

# Админка
ADMIN_PASSWORD="change-me"
AUTH_SECRET="replace-with-long-random-string"

# Часовой пояс ателье (для "сегодня" и слотов)
BUSINESS_TZ="Asia/Almaty"
PUBLIC_SITE_URL="http://localhost:3000"

# Telegram
TELEGRAM_BOT_TOKEN=""
ADMIN_CHAT_ID=""
# HTTPS-адрес сайта для Mini App (cloudflared/ngrok). Пусто = кнопка Mini App скрыта
MINIAPP_URL=""

# ИИ: ключи (пустой ключ = провайдер пропускается)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Цепочка моделей по приоритету: provider:model через запятую
AI_CHAIN="gemini:gemini-flash-latest,gemini:gemini-flash-lite-latest,openai:gpt-5-mini,anthropic:claude-haiku-4-5"
AI_TIMEOUT_MS="25000"
