DATABASE_URL="file:./dev.db"

# Админка / Admin panel
ADMIN_PASSWORD="change-me"
AUTH_SECRET="replace-with-long-random-string"
# Секрет Vercel Cron (напоминания о записях в 18:00 по Ташкенту); Vercel передаёт его в заголовке Authorization
CRON_SECRET=""

# Часовой пояс ателье и условный курс доллара
BUSINESS_TZ="Asia/Tashkent"
NEXT_PUBLIC_UZS_PER_USD="11900"
PUBLIC_SITE_URL="http://localhost:3000"

# Telegram
TELEGRAM_BOT_TOKEN=""
ADMIN_CHAT_ID=""
# Секрет webhook (A-Z, a-z, 0-9, _ и -): Telegram присылает его в заголовке, чужие запросы отклоняются
TELEGRAM_WEBHOOK_SECRET=""
# Адрес Mini App, если он отличается от PUBLIC_SITE_URL (например, туннель cloudflared/ngrok локально).
# Кнопка Mini App показывается только для https-адреса
MINIAPP_URL=""

# ИИ: ключи (пустой ключ = провайдер пропускается)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Цепочка моделей по приоритету: provider:model через запятую
AI_CHAIN="gemini:gemini-3.5-flash,gemini:gemini-3.5-flash-lite,openai:gpt-5.6-luna,anthropic:claude-haiku-4-5"
AI_TIMEOUT_MS="15000"
